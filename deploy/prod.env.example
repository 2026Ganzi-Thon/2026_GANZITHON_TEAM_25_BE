# 서버에서 /opt/mongle/.env 로 복사해 채운다 (chmod 600). 실제 값은 절대 커밋하지 않는다.
# 주의: 값 안에 & 같은 셸 특수문자가 있으면 따옴표로 감싼다.

# DB 계정 비밀번호 (이 서버에서만 쓰는 새 값. 개발용 mongle-dev 재사용 금지)
DB_PASSWORD=
DB_ROOT_PASSWORD=

# access 토큰 서명 키. 생성: openssl rand -base64 48
JWT_SECRET=

# Google AI Studio 키. 비우면 AI는 폴백 문구로만 응답한다. 이 값은 서버에 직접 입력하고 채팅·레포에 붙이지 않는다.
GEMINI_API_KEY=

# 프론트 origin (여러 개면 쉼표). 예: https://mongle-dev.netlify.app
ALLOWED_ORIGINS=

# 백엔드가 받을 도메인 (A 레코드가 이 서버 공인 IP를 가리켜야 함). 예: api.example.com
SITE_ADDRESS=
