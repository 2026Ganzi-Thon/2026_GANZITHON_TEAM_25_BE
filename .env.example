# 실제 값은 각자 로컬 .env에만 채우고 절대 커밋하지 않는다 (.gitignore 처리됨).
# 키 목록 출처: API_명세서_v1 1장(인증), 4.3장(Gemini)

SPRING_PROFILES_ACTIVE=dev

# docker-compose 기준 (로컬에 MySQL이 따로 있으면 포트/계정만 바꿔서 직접 띄워도 됨)
DB_URL=jdbc:mysql://localhost:3308/mongle?serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=mongle
DB_PASSWORD=mongle-dev

# access 토큰 서명 키 — 256비트(32바이트) 이상. 생성: openssl rand -base64 48
JWT_SECRET=

# Google AI Studio(aistudio.google.com)에서 발급. 비워두면 서버는 정상 기동하고,
# reflections·memories/preview는 전부 폴백 문구/원문 축약으로 응답한다(에러 아님).
GEMINI_API_KEY=

# 웹 프런트가 생기면 그 origin을 넣는다. 네이티브 앱이면 안 써도 된다 (Bearer 토큰 기반이라
# CORS 자체가 필요 없음 — API_명세서_v1 9장 "프론트엔드 스택 미정" 블로커에 대한 답).
ALLOWED_ORIGINS=*
